{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sk-portfolio",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "sanketkandel.com.np",
      "custom_domain": true
    },
    {
      "pattern": "www.sanketkandel.com.np",
      "custom_domain": true
    }
  ]
}
